# Copy this file to crab_dump.env and replace every placeholder before starting.
# DATABASE_URL_0 should point at a PostgreSQL database reachable by this host.
# URL-encode special characters in the database username and password.
DATABASE_URL_0=postgresql://user:replace-with-database-password@127.0.0.1:5432/app
DB_NAME_0=app

# Create a Telegram bot with @BotFather and add it to the target chat.
TG_BOT_TOKEN=replace-with-telegram-bot-token
TG_CHAT_ID_0=123456

# The dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-unique-secret

ENCRYPTION_TYPE=age-passphrase
AGE_PASSPHRASE=use-a-long-unique-passphrase


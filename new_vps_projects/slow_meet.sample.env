# Copy this file to slow_meet.env and replace both passwords before starting.

ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
#MEETING_PASSWORD=replace-with-a-long-unique-meeting-password

# Direct ICE connectivity uses this UDP range. Open it in host/cloud firewalls
# only when you are ready to expose SlowMeet.
ICE_UDP_PORT_MIN=50000
ICE_UDP_PORT_MAX=50100
ICE_PUBLIC_IP=

STUN_SERVERS=
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=86400

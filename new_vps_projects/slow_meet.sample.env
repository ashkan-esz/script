# Copy this file to slow_meet.env and replace the secrets before starting.

ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
#MEETING_PASSWORD=replace-with-a-long-unique-meeting-password

# Optional TURN credentials. Configure TURN_URLS in compose.yaml when using TURN.
TURN_USERNAME=
TURN_PASSWORD=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=86400
